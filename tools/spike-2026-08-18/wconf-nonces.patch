+/* W-CONF PATCH (see WCONF-PATCH.md). Wide reduction of a 512-bit big-endian
+ * integer modulo n, for the nonce derivation in wconf_generate_nonces().
+ *
+ * Upstream has no wide reduce: generate_deterministic_nonces() folded a
+ * 32-byte HMAC output with secp256k1_mpt_scalar_reduce32, which is biased by
+ * ~2^-128 against a uniform scalar, and handled the out-of-range case by
+ * re-deriving with an extra counter byte. REVIEW-005c section 2 requires a
+ * wide reduction precisely so that no rejection-sampling branch exists.
+ *
+ * Computed as (hi * 2^128 * 2^128 + lo) mod n rather than with a hardcoded
+ * 2^256 mod n constant: every step is an operation in the scalar field, so
+ * the result is correct by construction and there is no transcribed
+ * curve-order-derived magic number to get wrong. Residual bias over a
+ * uniform 512-bit input is ~2^-256.
+ */
+void secp256k1_mpt_scalar_reduce64(unsigned char out32[32],
+                                   const unsigned char in64[64])
+{
+  secp256k1_scalar s_hi, s_lo, s_shift;
+  /* 2^128 as a scalar: byte 15 (big-endian) set to 1. */
+  unsigned char shift_be[32];
+  memset(shift_be, 0, 32);
+  shift_be[15] = 1;
+
+  /* Overflow outputs discarded: reduction mod n is the contract here, as in
+   * secp256k1_mpt_scalar_reduce32 below. */
+  secp256k1_scalar_set_b32(&s_hi, in64, NULL);
+  secp256k1_scalar_set_b32(&s_lo, in64 + 32, NULL);
+  secp256k1_scalar_set_b32(&s_shift, shift_be, NULL);
+
+  /* s_hi <- s_hi * 2^256 == (s_hi * 2^128) * 2^128 */
+  secp256k1_scalar_mul(&s_hi, &s_hi, &s_shift);
+  secp256k1_scalar_mul(&s_hi, &s_hi, &s_shift);
+  secp256k1_scalar_add(&s_hi, &s_hi, &s_lo);
+  secp256k1_scalar_get_b32(out32, &s_hi);
+
+  /* SECURE CLEANUP */
+  OPENSSL_cleanse(&s_hi, sizeof(s_hi));
+  OPENSSL_cleanse(&s_lo, sizeof(s_lo));
+  OPENSSL_cleanse(&s_shift, sizeof(s_shift));
+}
