+/** One-shot HMAC-SHA512. out must have room for 64 bytes. */
+static inline int
+wconf_hmac_sha512(
+    unsigned char const* key,
+    size_t key_len,
+    unsigned char const* const* chunks,
+    size_t const* chunk_lens,
+    size_t n_chunks,
+    unsigned char out[64])
+{
+    EVP_MAC* mac = EVP_MAC_fetch(NULL, "HMAC", NULL);
+    EVP_MAC_CTX* mctx = NULL;
+    size_t mac_len = 64;
+    int ok = 0;
