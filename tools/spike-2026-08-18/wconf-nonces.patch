+    if (!mac)
+        return 0;
+    mctx = EVP_MAC_CTX_new(mac);
+    if (!mctx)
+    {
+        EVP_MAC_free(mac);
+        return 0;
+    }
+    {
+        OSSL_PARAM params[] = {
+            OSSL_PARAM_construct_utf8_string("digest", "SHA512", 0), OSSL_PARAM_construct_end()};
+        if (!EVP_MAC_init(mctx, key, key_len, params))
+            goto done;
+        for (size_t i = 0; i < n_chunks; i++)
+        {
+            if (chunk_lens[i] == 0)
+                continue;
+            if (!EVP_MAC_update(mctx, chunks[i], chunk_lens[i]))
+                goto done;
+        }
+        if (!EVP_MAC_final(mctx, out, &mac_len, 64) || mac_len != 64)
+            goto done;
+        ok = 1;
+    }
