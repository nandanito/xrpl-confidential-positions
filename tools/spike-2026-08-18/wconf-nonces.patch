+static inline int
+wconf_mac_u32be(EVP_MAC_CTX* mctx, size_t v)
+{
+    unsigned char b[4];
+    b[0] = (unsigned char)((v >> 24) & 0xff);
+    b[1] = (unsigned char)((v >> 16) & 0xff);
+    b[2] = (unsigned char)((v >> 8) & 0xff);
+    b[3] = (unsigned char)(v & 0xff);
+    return EVP_MAC_update(mctx, b, 4);
+}
